# Единый конфиг окружения. Скопируйте в .env и правьте под себя.
# ВНИМАНИЕ: docker-compose и pydantic-settings читают ИМЕННО этот файл.

# Postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=messenger_db

# Redis (сессии). В docker-compose backend получает redis://redis:6379/0
# через environment: — здесь только локальный дефолт для запуска вне Docker.
REDIS_URL=redis://localhost:6379/0

# Cookie / CSRF
# production (за HTTPS): COOKIE_SECURE=true
# local dev (http):      COOKIE_SECURE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Reverse proxy: IP/CIDR, которым доверяем X-Forwarded-For.
# Пусто (по умолчанию) — заголовок игнорируется.
# Для local dev с nginx: ["127.0.0.1"]
# Для Docker (nginx на 172.17.0.0/16): ["172.17.0.0/16"]
# TRUSTED_PROXIES=["127.0.0.1", "172.16.0.0/12"]
